# Copy to base/pi.env (git-ignored) and fill in. Read by base/scripts/*.sh.
# These are personal details, so the real values stay out of the repo.

# Network name of the Pi. Reachable as <PI_HOSTNAME>.local where mDNS works.
PI_HOSTNAME=changeme-hostname

# The Pi's address as reachable from the laptop. Use the IP (the router's
# reservation keeps it fixed): mDNS names like <hostname>.local do not resolve
# from inside WSL2. Read by personal_website/scripts/deploy.sh.
PI_ADDRESS=192.168.0.0

# Login account created on the Pi. Avoid "pi": it is the first name anyone tries.
PI_USER=changeme-user

# IANA time zone name (see `timedatectl list-timezones`). Affects log timestamps.
PI_TIMEZONE=Europe/London
