#cloud-config
# TEMPLATE. The real file is generated by base/scripts/patch-cloud-init.sh (or by
# Raspberry Pi Imager's OS customisation) and lives on the SD card's `bootfs`
# partition as /boot/firmware/user-data. It is git-ignored because it holds a
# password hash and an SSH public key.

# Network name of the Pi.
hostname: <PI_HOSTNAME>
# Keep /etc/hosts in step with the hostname so sudo does not complain.
manage_etc_hosts: true

timezone: <PI_TIMEZONE>

users:
  - name: <PI_USER>
    groups: users,adm,dialout,audio,netdev,video,plugdev,cdrom,games,input,gpio,spi,i2c,render,sudo
    shell: /bin/bash
    lock_passwd: false
    # SHA-512 crypt hash from `openssl passwd -6`. Never a plain-text password.
    passwd: '<PASSWORD_HASH>'
    ssh_authorized_keys:
      - <CONTENTS_OF_YOUR_PUBLIC_KEY_FILE>

# Key-only SSH: password logins over the network are refused.
enable_ssh: true
ssh_pwauth: false
